+/**
+ * IOSurface-backed Metal textures must be simple 2D single-sample images in
+ * a supported color format; anything else keeps the stock shared path so a
+ * gated game's other NT-shared textures see no behavior change.
+ */
+static bool
+IsBasaltIOSurfaceCompatible(const WMTTextureInfo &info) {
+  if (info.type != WMTTextureType2D || info.mipmap_level_count != 1 || info.array_length != 1 ||
+      info.sample_count != 1)
+    return false;
+  switch (info.pixel_format) {
+  case WMTPixelFormatRGBA8Unorm:
+  case WMTPixelFormatRGBA8Unorm_sRGB:
+  case WMTPixelFormatBGRA8Unorm:
+  case WMTPixelFormatBGRA8Unorm_sRGB:
+    return true;
+  default:
+    return false;
+  }
+}
