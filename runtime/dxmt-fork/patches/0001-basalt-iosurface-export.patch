+/*
+ * Basalt extension. Create (mach_port == 0) or import (mach_port != 0) a
+ * texture whose backing store is an IOSurface, so a non-Wine process can map
+ * the same pixels via IOSurfaceLookup(info->reserved). A nil result is
+ * reported as ret == 0 with STATUS_SUCCESS, matching _MTLDevice_newTexture.
+ */
+static NTSTATUS
+_MTLDevice_newTextureFromIOSurface(void *obj) {
+  struct unixcall_mtldevice_newtexture *params = obj;
+  id<MTLDevice> device = (id<MTLDevice>)params->device;
+  struct WMTTextureInfo *info = params->info.ptr;
+
+  params->ret = 0;
+
+  /*
+   * Metal requires IOSurface-backed textures to be simple 2D single-sample
+   * images; reject anything else here so an invalid descriptor degrades to a
+   * nil texture instead of an ObjC assertion aborting the Wine process.
+   */
+  if (info->type != WMTTextureType2D || info->mipmap_level_count != 1 ||
+      info->array_length != 1 || info->sample_count != 1)
+    return STATUS_SUCCESS;
+
+  IOSurfaceRef surface = NULL;
+  if (info->mach_port) {
+    surface = IOSurfaceLookupFromMachPort(info->mach_port);
+    if (!surface)
+      return STATUS_SUCCESS;
+  } else {
+    uint32_t pixel_format;
+    switch (info->pixel_format) {
+    case WMTPixelFormatBGRA8Unorm:
+    case WMTPixelFormatBGRA8Unorm_sRGB:
+      pixel_format = 'BGRA';
+      break;
+    case WMTPixelFormatRGBA8Unorm:
+    case WMTPixelFormatRGBA8Unorm_sRGB:
+      pixel_format = 'RGBA';
+      break;
+    default:
+      /* Only the Basalt swapchain color formats are supported for now. */
+      return STATUS_SUCCESS;
+    }
+    size_t bytes_per_element = 4;
+    size_t bytes_per_row =
+        IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, (size_t)info->width * bytes_per_element);
+    /*
+     * kIOSurfaceIsGlobal (spelled out to avoid the deprecation warning) is
+     * required for the Basalt daemon's IOSurfaceLookup-by-ID handoff; the
+     * supported replacement is mach-port transfer, which the daemon protocol
+     * deliberately avoids. Same-user processes can look these surfaces up,
+     * which is why the daemon validates them as untrusted input.
+     */
+    NSDictionary *properties = @{
+      (__bridge NSString *)kIOSurfaceWidth : @(info->width),
+      (__bridge NSString *)kIOSurfaceHeight : @(info->height),
+      (__bridge NSString *)kIOSurfaceBytesPerElement : @(bytes_per_element),
+      (__bridge NSString *)kIOSurfaceBytesPerRow : @(bytes_per_row),
+      (__bridge NSString *)kIOSurfacePixelFormat : @(pixel_format),
+      @"IOSurfaceIsGlobal" : @YES,
+    };
+    surface = IOSurfaceCreate((__bridge CFDictionaryRef)properties);
+    if (!surface)
+      return STATUS_SUCCESS;
+  }
+
+  MTLTextureDescriptor *desc = [[MTLTextureDescriptor alloc] init];
+  fill_texture_descriptor(desc, info);
+  /* IOSurface-backed textures cannot use private storage. */
+  desc.storageMode = MTLStorageModeShared;
+
+  id<MTLTexture> ret = [device newTextureWithDescriptor:desc iosurface:surface plane:0];
+  [desc release];
+  if (!ret) {
+    CFRelease(surface);
+    return STATUS_SUCCESS;
+  }
+
+  extract_texture_descriptor(ret, info);
+  info->reserved = IOSurfaceGetID(surface);
+  info->gpu_resource_id = [ret gpuResourceID]._impl;
+  if (!info->mach_port)
+    info->mach_port = IOSurfaceCreateMachPort(surface);
+  /* The texture and the mach port each hold their own surface reference. */
+  CFRelease(surface);
+  params->ret = (obj_handle_t)ret;
+  return STATUS_SUCCESS;
+}
