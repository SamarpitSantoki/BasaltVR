+ * Basalt extension: when DXMT_BASALT_IOSURFACE=1, NT-handle shared textures
+ * are backed by an IOSurface and republish its global IOSurfaceID through
+ * ID3D11DeviceChild::GetPrivateData under this GUID.
+ * {DD807311-529E-4856-A5C0-48BED2048129}
+ */
+static const GUID BASALT_GUID_IOSURFACE_ID = {
+    0xdd807311, 0x529e, 0x4856, {0xa5, 0xc0, 0x48, 0xbe, 0xd2, 0x04, 0x81, 0x29}};
