set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

find_program(BASALT_MINGW_C x86_64-w64-mingw32-gcc REQUIRED)
find_program(BASALT_MINGW_CXX x86_64-w64-mingw32-g++ REQUIRED)
find_program(BASALT_MINGW_RC x86_64-w64-mingw32-windres REQUIRED)

set(CMAKE_C_COMPILER "${BASALT_MINGW_C}" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${BASALT_MINGW_CXX}" CACHE FILEPATH "")
set(CMAKE_RC_COMPILER "${BASALT_MINGW_RC}" CACHE FILEPATH "")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
